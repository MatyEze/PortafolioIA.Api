{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SupaBasePostgres": "Host=db.onznuemseromckhhrfmx.supabase.co;Database=postgres;Username=postgres;SSL Mode=Require;Trust Server Certificate=true"
    //"SupaBasePostgres": "Host=db.onznuemseromckhhrfmx.supabase.co;Database=postgres;Username=postgres;SSL Mode=Disable;Password=PASS" //para migracion
  },
  "Database": {
    "Password": "" //secret - se configura en user secrets o variables de entorno
  },
  "Jwt": {
    "SecretKey": "", // REQUERIDO: Al menos 32 caracteres - configurar en user secrets
    "Issuer": "PortafolioIA.Api",
    "Audience": "PortafolioIA.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "ClockSkewSeconds": 0
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  },
  "Security": {
    "RequireHttps": false, // true en producción
    "RequireEmailVerification": true,
    "MaxLoginAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordMinLength": 8,
    "RequireComplexPassword": true
  },
  "Email": {
    "From": "noreply@portafolioia.com",
    "FromName": "PortafolioIA",
    "Provider": "SendGrid", // SendGrid, SMTP, etc.
    "SendGrid": {
      "ApiKey": "" // secret
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": ""
    }
  }
}